import React, { useState } from 'react';
import { Shield, Users, MessageSquare, Briefcase, PlusCircle, Loader2 } from 'lucide-react';
import { addProfessional } from '../services/professionalService'; // <-- Importamos el servicio recién creado

// Definimos los tipos para las pestañas
type AdminTab = 'users' | 'queries' | 'professionals';

// --- Sub-componente para el formulario de profesionales ---
const ProfessionalForm: React.FC = () => {
  const [name, setName] = useState('');
  const [specialty, setSpecialty] = useState('');
  const [imageUrl, setImageUrl] = useState('');
  const [isLoading, setIsLoading] = useState(false);
  const [feedback, setFeedback] = useState<{ type: 'success' | 'error', message: string } | null>(null);

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!name || !specialty) {
      setFeedback({ type: 'error', message: 'El nombre y la especialidad son obligatorios.' });
      return;
    }
    
    setIsLoading(true);
    setFeedback(null);

    try {
      // Usamos el servicio para añadir el profesional a Firestore
      await addProfessional({ name, specialty, imageUrl });
      setFeedback({ type: 'success', message: '¡Profesional añadido con éxito!' });
      // Limpiar formulario
      setName('');
      setSpecialty('');
      setImageUrl('');
    } catch (error) {
      console.error('Error al añadir el profesional:', error);
      setFeedback({ type: 'error', message: 'No se pudo añadir el profesional. Inténtalo de nuevo.' });
    } finally {
      setIsLoading(false);
      // Ocultar mensaje después de 3 segundos
      setTimeout(() => setFeedback(null), 3000);
    }
  };

  return (
    <form onSubmit={handleSubmit} className="space-y-4 max-w-lg mx-auto">
      <div className="grid grid-cols-1 gap-2">
        <label htmlFor="name" className="text-sm font-medium text-gray-700">Nombre Completo</label>
        <input id="name" type="text" value={name} onChange={(e) => setName(e.target.value)} className="border border-gray-300 rounded-md p-2" placeholder="Ej: Dr. Juan Pérez" />
      </div>
      <div className="grid grid-cols-1 gap-2">
        <label htmlFor="specialty" className="text-sm font-medium text-gray-700">Especialidad</label>
        <input id="specialty" type="text" value={specialty} onChange={(e) => setSpecialty(e.target.value)} className="border border-gray-300 rounded-md p-2" placeholder="Ej: Psicología Clínica" />
      </div>
      <div className="grid grid-cols-1 gap-2">
        <label htmlFor="imageUrl" className="text-sm font-medium text-gray-700">URL de la Imagen (Opcional)</label>
        <input id="imageUrl" type="text" value={imageUrl} onChange={(e) => setImageUrl(e.target.value)} className="border border-gray-300 rounded-md p-2" placeholder="https://ejemplo.com/imagen.jpg" />
      </div>
      <button type="submit" disabled={isLoading} className="w-full flex justify-center items-center gap-2 bg-brand-purple text-white font-bold py-2 px-4 rounded-md hover:bg-brand-dark-blue transition-colors disabled:bg-gray-400">
        {isLoading ? <><Loader2 className="animate-spin" /> Procesando...</> : <><PlusCircle /> Añadir Profesional</>}
      </button>
      {feedback && (
        <div className={`p-3 rounded-md text-sm text-center ${feedback.type === 'success' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}`}>
          {feedback.message}
        </div>
      )}
    </form>
  );
};


const Admin: React.FC = () => {
  // Por defecto, la pestaña de profesionales estará activa para ver los cambios directamente.
  const [activeTab, setActiveTab] = useState<AdminTab>('professionals');

  const TabContent: React.FC<{ tab: AdminTab }> = ({ tab }) => {
    let title = '';
    let description = '';
    let Icon = Users;

    switch (tab) {
      case 'users':
        title = 'Gestión de Usuarios';
        description = 'Aquí podrás ver, buscar y gestionar los perfiles de todos los usuarios registrados.';
        Icon = Users;
        break;
      case 'queries':
        title = 'Registro de Consultas a la IA';
        description = 'Historial de consultas realizadas al servicio de IA para monitoreo.';
        Icon = MessageSquare;
        break;
      case 'professionals':
        title = 'Gestión de Profesionales';
        description = 'Añade nuevos perfiles de profesionales a la plataforma. La lista se actualizará en la página pública.';
        Icon = Briefcase;
        break;
    }

    // Contenido específico para cada pestaña
    const getTabContent = () => {
      switch (tab) {
        case 'professionals':
          return <ProfessionalForm />;
        case 'users':
        case 'queries':
        default:
          return (
            <div className="mt-8 border-2 border-dashed border-gray-200 rounded-lg h-64 flex items-center justify-center">
              <p className="text-gray-400">Contenido futuro de la sección.</p>
            </div>
          );
      }
    };

    return (
      <div className="bg-white p-8 rounded-lg shadow">
        <div className="flex items-center gap-4 mb-4">
          <Icon className="text-brand-purple" size={28} />
          <h2 className="text-2xl font-bold text-gray-800">{title}</h2>
        </div>
        <p className="text-gray-600">{description}</p>
        <div className="mt-8">{getTabContent()}</div>
      </div>
    );
  };

  const renderTab = (tab: AdminTab, label: string, Icon: React.ElementType) => {
    const isActive = activeTab === tab;
    return (
      <button
        onClick={() => setActiveTab(tab)}
        className={`flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-md transition-colors ${isActive ? 'bg-brand-purple text-white shadow' : 'text-gray-600 hover:bg-gray-200'}`}>
        <Icon size={16} />
        {label}
      </button>
    );
  };

  return (
    <div className="container mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div className="flex items-center gap-4 mb-8">
        <Shield className="text-brand-dark-blue" size={32} />
        <h1 className="text-3xl font-bold text-gray-800">Panel de Administración</h1>
      </div>
      <div className="flex space-x-2 border-b border-gray-200 mb-8">
        {renderTab('users', 'Usuarios', Users)}
        {renderTab('queries', 'Consultas IA', MessageSquare)}
        {renderTab('professionals', 'Profesionales', Briefcase)}
      </div>
      <div>
        <TabContent tab={activeTab} />
      </div>
    </div>
  );
};

export default Admin;